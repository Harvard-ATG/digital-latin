# Digital Latin Project - Environment Configuration
# Copy this file to the project root as `.env` and fill in your actual values.
# Keep the .env file file secure and do not commit it to version control.

# IMPORTANT: Docker Compose Limitation
# While best practice would be separate .env files for frontend/backend services,
# Docker Compose does not support variable substitution (${VAR}) when using 
# service-specific env_file directives. Therefore, this single root .env file
# contains ALL variables needed for:
# 1. Docker Compose substitution (${VAR} in docker-compose.yml)  
# 2. Container runtime environment variables
#
# For production alignment, ensure these variables match your production environment.

# ------ FRONTEND & DATABASE CONFIGURATION ------

# Google Gemini API Settings
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_ALLOWED_MODELS=gemini-2.5-pro,gemini-1.5-flash
GOOGLE_API_BASE_URL=https://go.apis.huit.harvard.edu/ais-google-gemini

# Database Configuration
SESSION_DB_BACKEND=postgres
SKIP_DB=false

# PostgreSQL Settings (used for both app connection AND Docker Compose substitution)
DB_NAME=sessions
DB_HOST=digital-latin-postgres
DB_PORT=5432
DB_USER=your_postgres_user_here
DB_PASSWORD=your_postgres_password_here

# Flow API Configuration  
FLOW_API_URL=http://digital-latin-flow:8080/score
# Alternative: FLOW_API_URL=http://digital-latin.dev.tlt.harvard.edu/score

# Authentication
AUTH_USER_1=user_1_username
AUTH_PASSWORD_1=password_1
AUTH_USER_2=user_2_username
AUTH_PASSWORD_2=password_2
AUTH_USER_3=user_3_username
AUTH_PASSWORD_3=password_3

# ------ BACKEND CONFIGURATION ------

# AWS Credentials
AWS_AI_WORKFLOW_CORE_DEV_ID=your_aws_access_key_id
AWS_AI_WORKFLOW_CORE_DEV_SECRET=your_aws_access_key_password
AWS_DEFAULT_REGION=your_region

# Keyring Configuration
PYTHON_KEYRING_BACKEND=keyrings.cryptfile.cryptfile.CryptFileKeyring
KEYRING_CRYPTFILE_PASSWORD=your_keyring_kryptfile_password

# Gemini API (Backend Service)
GEMINI_API_KEY=your_huit_harvard_port_gemini_api_key
GEMINI_BASE_URL=https://go.apis.huit.harvard.edu/ais-google-gemini